{
  "datasets": [
    {
      "name": "ds_summary",
      "displayName": "Pipeline summary (1 row)",
      "queryLines": [
        "SELECT ",
        "  (SELECT count(*) FROM image_catalog) AS total_ingested, ",
        "  (SELECT round(avg(person_count), 1) FROM image_catalog) AS avg_persons, ",
        "  (SELECT count(DISTINCT source_path) FROM image_catalog) AS source_files, ",
        "  (SELECT round((unix_timestamp(current_timestamp()) - unix_timestamp(max(ingested_at))) / 60.0, 0) ",
        "     FROM image_catalog) AS minutes_since_ingest "
      ]
    },
    {
      "name": "ds_catalog",
      "displayName": "Image catalog (AI-enriched)",
      "queryLines": [
        "SELECT filename, media_type, ingested_at, width, height, person_count, contains_faces, quality, caption, ",
        "  array_join(tags, ', ') AS tags_str, ",
        "  round(width * height / 1000000.0, 1) AS megapixels ",
        "FROM image_catalog "
      ]
    },
    {
      "name": "ds_tags",
      "displayName": "Exploded AI tags",
      "queryLines": [
        "SELECT tag ",
        "FROM (SELECT explode(tags) AS tag FROM image_catalog) "
      ]
    }
  ],
