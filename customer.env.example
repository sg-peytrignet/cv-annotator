# =============================================================================
# CV Annotator — per-customer configuration
# =============================================================================
# Copy this file to `customer.env` and fill in the values for YOUR workspace.
# `customer.env` is gitignored (it names customer workspaces) — never commit it.
#
# Everything here is either a Databricks CLI setting (DATABRICKS_*) or a DABs bundle
# variable (BUNDLE_VAR_<name>), which `databricks bundle` reads natively from the
# environment. You do NOT edit databricks.yml or app.yaml per customer.
#
# Deploy (macOS / Linux):
#     set -a; source customer.env; set +a
#     databricks bundle deploy
#
# Deploy (Windows PowerShell) — `source` doesn't exist there, so set the same
# values as environment variables and run the identical command:
#     $env:DATABRICKS_CONFIG_PROFILE="my-profile"
#     $env:BUNDLE_VAR_catalog="my_catalog"
#     $env:BUNDLE_VAR_existing_cluster_id="0123-456789-abcdefgh"
#     $env:BUNDLE_VAR_warehouse_id="1234567890abcdef"
#     databricks bundle deploy
#
# Or pass them inline on any platform:
#     databricks bundle deploy --var="catalog=my_catalog,existing_cluster_id=...,warehouse_id=..."
# -----------------------------------------------------------------------------


# =============================================================================
# REQUIRED — no defaults. The deploy fails if these are unset.
# =============================================================================

# --- Target workspace -------------------------------------------------------
# The profile name you chose during `databricks auth login --host <your-workspace-host>`
# (the CLI prompts for it). Selects the target workspace without editing databricks.yml.
export DATABRICKS_CONFIG_PROFILE="my-profile"

# --- Unity Catalog ----------------------------------------------------------
# The catalog MUST ALREADY EXIST (it needs a storage location, so the bundle
# cannot create it). The schema and volumes below are created for you.
export BUNDLE_VAR_catalog="my_catalog"

# --- Compute ----------------------------------------------------------------
# Existing all-purpose cluster the pipeline/ML jobs run on (avoids ~10-min
# job-cluster cold starts). Must be startable in the workspace.
#   list them: databricks clusters list --profile "$DATABRICKS_CONFIG_PROFILE"
export BUNDLE_VAR_existing_cluster_id=""

# SQL warehouse for the dataset-health Lakeview dashboard.
#   list them: databricks warehouses list --profile "$DATABRICKS_CONFIG_PROFILE"
export BUNDLE_VAR_warehouse_id=""


# =============================================================================
# OPTIONAL — these already have working defaults in databricks.yml.
# Uncomment only to override.
# =============================================================================

# Schema created inside the catalog above.                (default: cv_annotator)
#export BUNDLE_VAR_schema="cv_annotator"

# Volume names. `landing` = where you upload; `images` = what the app reads
# (curated by the ingest job) ; `exports` = COCO training datasets.
#export BUNDLE_VAR_landing_volume="landing"
#export BUNDLE_VAR_images_volume="images"
#export BUNDLE_VAR_exports_volume="exports"

# Databricks App name — <=30 chars, lowercase/hyphens, unique in the workspace.
#                                                          (default: cv-labeler)
#export BUNDLE_VAR_app_name="cv-labeler"

# UC model name registered by the train task.         (default: object_detector)
#export BUNDLE_VAR_model_name="object_detector"

# Model Serving endpoint name (letters/numbers/hyphens only). Blank lets the
# deploy task derive it as "<model_name>-endpoint".              (default: blank)
#export BUNDLE_VAR_serving_endpoint_name=""
